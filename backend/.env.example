APP_ENV=local
APP_ORIGIN=http://localhost:5173
# 额外乘客端源地址（逗号分隔）；也可在管理台“乘客端接入”中即时添加。
PASSENGER_ORIGINS=
ADMIN_ORIGIN=http://localhost:5174
APP_SECURE_COOKIE=0
# 本地快速演示；生产必须设 APP_ENV=production、DEMO_MODE=0 并配置 MySQL 或 PostgreSQL、Redis、OAuth、SM2。
DEMO_MODE=1
DB_DSN=sqlite:runtime/taxilink.sqlite
DB_USER=
DB_PASSWORD=
# DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=taxilink;charset=utf8mb4
# PostgreSQL（需安装 pdo_pgsql，库编码 UTF8，账号拥有 public schema 建表权限）
# DB_DSN=pgsql:host=127.0.0.1;port=5432;dbname=taxilink;sslmode=prefer;connect_timeout=3
REDIS_URL=
PORTAL_ISSUER=https://hydcraft.cn
PORTAL_CLIENT_ID=
PORTAL_CLIENT_SECRET=
PORTAL_REDIRECT_URI=http://localhost:8787/api/auth/callback
PORTAL_ADMIN_REDIRECT_URI=http://localhost:5174/api/auth/callback
# 首个管理员仅按 Portal sub 精确匹配，绝不继承 Portal 的 role。
PLATFORM_ADMIN_SUB=
GATEWAY_URL=http://127.0.0.1:8789
GATEWAY_TOKEN=
TAXILINK_SERVER_ID=taxilink-01
TAXILINK_DIMENSION=minecraft/overworld
TAXILINK_OPENSSL=openssl
TAXILINK_GATEWAY_PRIVATE_KEY=keys/gateway-private.pem
TAXILINK_MOD_PUBLIC_KEY=keys/mod-public.pem
QUEUE_TIMEOUT_SECONDS=300

# 腾讯云 COS：兼容旧环境配置；管理台保存后使用数据库设置并即时生效。
# 配置加密密钥默认 installation/settings.key，需随数据库备份。
# SETTINGS_KEY_FILE=installation/settings.key
# 图片桶需允许公开读取或使用公开 CDN 域名。
COS_BUCKET=
COS_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=
# 可选 HTTPS CDN 根地址，留空使用 COS 桶域名
COS_PUBLIC_URL=

# UnionCashier SM2/SM3 所需 OpenSSL 3 CLI（商户信息在管理端配置）
CASHIER_OPENSSL=openssl
