APP_ENV=local
APP_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
APP_SECURE_COOKIE=0
# 本地快速演示；生产必须设 APP_ENV=production、DEMO_MODE=0 并配置 MySQL/Redis/OAuth/SM2。
DEMO_MODE=1
DB_DSN=sqlite:runtime/taxilink.sqlite
DB_USER=
DB_PASSWORD=
# DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=taxilink;charset=utf8mb4
REDIS_URL=
PORTAL_ISSUER=https://hydcraft.cn
PORTAL_CLIENT_ID=
PORTAL_CLIENT_SECRET=
PORTAL_REDIRECT_URI=http://localhost:8787/api/auth/callback
# 首个管理员仅按 Portal sub 精确匹配，绝不继承 Portal 的 role。
PLATFORM_ADMIN_SUB=
GATEWAY_URL=http://127.0.0.1:8789
GATEWAY_TOKEN=
TAXILINK_SERVER_ID=taxilink-01
TAXILINK_DIMENSION=minecraft/overworld
TAXILINK_OPENSSL=openssl
TAXILINK_GATEWAY_PRIVATE_KEY=keys/gateway-private.pem
TAXILINK_MOD_PUBLIC_KEY=keys/mod-public.pem
QUEUE_TIMEOUT_SECONDS=300
