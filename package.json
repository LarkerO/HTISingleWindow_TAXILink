{
  "name": "htisinglewindow-taxilink",
  "private": true,
  "workspaces": [
    "admin",
    "passenger"
  ],
  "scripts": {
    "dev:admin": "npm run dev -w admin",
    "dev:passenger": "npm run dev -w passenger",
    "build": "npm run build --workspaces",
    "test": "php backend/tests/domain.php && php backend/tests/bootstrap.php && php backend/tests/migration-release.php && php backend/tests/operations-storage.php && npm run test:oauth && npm run test:quotes && npm run test:resilience",
    "test:cashier": "php backend/tests/cashier.php",
    "test:database": "php backend/tests/database.php",
    "test:oauth": "node --test tests/oauth/*.test.mjs",
    "test:quotes": "node --test tests/quote-routes.test.mjs",
    "test:resilience": "node --test tests/frontend-resilience.test.mjs",
    "test:ui-resilience": "node --test tests/ui-resilience.test.mjs",
    "test:api": "node --test tests/api.test.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@prettier/plugin-php": "^0.26.0",
    "@types/markdown-it": "^14.2.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  },
  "version": "0.5.2"
}
